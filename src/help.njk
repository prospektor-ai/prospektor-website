---
layout: base.njk
title: Help
description: "Short answers to how Prospektor works: who to pitch, what to send, warm intros and your account."
stylesheet: /assets/css/help.css
# One hub per EDITION (#535): /help/ in English, and /<code>/help/ for every
# language the studio holds at least one article in. src/_data/help.js
# decides the list from the studio's own answer, never from a list kept here.
pagination:
  data: help.editions
  size: 1
  alias: edition
  addAllPagesToCollections: true
permalink: "{{ edition.prefix }}/help/"
---
{#-
  The help hub (studio #1201, 7 Oct 2026). The operator called the old hub
  "horrendous AI-slop", and it was the studio's long reference files under
  emoji cards. Now it is short articles under four big tiles, the homepage's
  look: a heading, one search field, a card for the first article, the four
  tiles (each with its drawing and its articles in order), the account
  articles as pills, and one line for anyone still stuck.

  Search filters the articles by title and dek in the browser, from the small
  index at the foot of this page. It asks nothing of the network.
-#}
{%- macro drawing(key) -%}
{%- if key == 'who' -%}
<div class="hp-draw-card"><div class="hp-draw-row"><span class="hp-draw-logo"></span><span class="hp-draw-bar hp-w90"></span><span class="hp-draw-score">86</span></div><span class="hp-draw-bar hp-w80p"></span></div>
{%- elif key == 'what' -%}
<div class="hp-draw-card hp-draw-letter"><span class="hp-draw-bar hp-w40p hp-dark"></span><span class="hp-draw-bar hp-w95p"></span><span class="hp-draw-bar hp-w85p"></span><span class="hp-draw-bar hp-w30p hp-coral"></span></div>
{%- elif key == 'warm' -%}
<div class="hp-draw-chain"><span class="hp-draw-you"></span><span class="hp-draw-link"></span><span class="hp-draw-friend"></span><span class="hp-draw-link"></span><span class="hp-draw-them"></span></div>
{%- else -%}
<div class="hp-draw-bars"><span></span><span></span><span></span></div>
{%- endif -%}
{%- endmacro -%}
{%- set start = edition.topic.start.articles -%}
{%- set account = edition.topic.account.articles -%}
{%- set off = edition.code != 'en' -%}

<main class="hp-hub">

  <section class="hp-hero">
    <h1>{% t %}How can we help?{% endt %}</h1>
    <label class="hp-search" for="helpSearch">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
      <input id="helpSearch" type="search" placeholder="{% t %}Search help{% endt %}" aria-label="{% t %}Search help{% endt %}" autocomplete="off">
    </label>
  </section>

  {#- What the search shows while a query is typed; the hub below steps aside. -#}
  <section id="helpResults" class="hp-results" aria-live="polite" hidden>
    <div id="helpHits" class="hp-cards"></div>
    <p id="helpNone" class="hp-foot" hidden>{% t %}No article matches that. Try another word, or <a href="/contact/">write to us</a>.{% endt %}</p>
  </section>

  <div id="helpHub" class="hp-hub-body">
    {%- if start.length %}
    {%- set first = start[0] %}
    <a class="hp-start" href="{{ edition.prefix }}/help/{{ first.slug }}/">
      <span class="hp-start-text">
        <span class="hp-start-title">{% t %}New here?{% endt %} <span{% if first.language != edition.code %} lang="{{ first.language }}"{% endif %}>{{ first.title }}</span></span>
        <span class="hp-start-dek"{% if first.language != edition.code %} lang="{{ first.language }}"{% endif %}>{{ first.dek }}</span>
      </span>
      <span class="hp-round" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></span>
    </a>
    {%- if start.length > 1 %}
    <ul class="hp-pills hp-pills-start">
      {%- for a in start %}{% if not loop.first %}
      <li><a href="{{ edition.prefix }}/help/{{ a.slug }}/"{% if a.language != edition.code %} lang="{{ a.language }}"{% endif %}>{{ a.title }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
    {%- endif %}
    {%- endif %}

    <section class="hp-tiles">
      {%- for t in edition.topics %}{% if t.key != 'start' and t.key != 'account' and t.articles.length %}
      <div class="hp-tile" id="{{ t.key }}">
        <div class="hp-panel hp-tint-{{ t.key }}" aria-hidden="true">{{ drawing(t.key) | safe }}</div>
        <div class="hp-tile-body">
          <h2>{{ t.name | t }}</h2>
          <ul class="hp-list">
            {%- for a in t.articles %}
            <li><a href="{{ edition.prefix }}/help/{{ a.slug }}/"{% if a.language != edition.code %} lang="{{ a.language }}"{% endif %}>{{ a.title }}</a></li>
            {%- endfor %}
          </ul>
        </div>
      </div>
      {%- endif %}{% endfor %}
    </section>

    {%- if account.length %}
    <section class="hp-account" id="account">
      <h2>{{ 'Your account' | t }}</h2>
      <ul class="hp-pills">
        {%- for a in account %}
        <li><a href="{{ edition.prefix }}/help/{{ a.slug }}/"{% if a.language != edition.code %} lang="{{ a.language }}"{% endif %}>{{ a.title }}</a></li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}
  </div>

  <p class="hp-foot">{% t %}Still stuck? Ask the chat at the bottom right of the studio, or <a href="/contact/">write to us</a>.{% endt %}</p>
</main>

{#- The search index: every article's address, title and dek, nothing more.
    `<` is escaped so a title can never end the script element early. -#}
<script type="application/json" id="helpIndex">{{ edition.articles | helpIndex(edition.prefix) | safe }}</script>
<script src="{{ '/assets/js/help-search.js' | asset }}" defer></script>
