{% set intExtra %}
  <section class="pricing pricing-page" id="start">
    <div class="pricing-card">
      {#- Monthly only, deliberately: the offer below is a free month converting to
          a monthly subscription, and a plan switch beside it would be a second
          decision on a page that already has one (the style skill, rule 8). The
          yearly plan is one click away on /pricing/. -#}
      <div class="price-row">
        <span class="price-num">$999</span>
        <span class="price-per">{% t %}/ month · per workspace{% endt %}</span>
      </div>

      {%- if offer.close %}
      {#- #622. Written ONLY when this build's environment arms the offer, so the
          page cannot advertise a trial the checkout call would not grant — and
          the number below is `lib/trial.js`'s constant, which is also the only
          value `CLOSE_TRIAL_DAYS` will accept. test/close.test.js pins the two
          together in both directions. -#}
      <div class="onboard-note">
        <p>{% t %}<strong>First month free for Close users.</strong> Card on file, nothing
          charged for 30 days. Cancel inside them with one email to
          <a href="mailto:hello@prospektor.ai">hello@prospektor.ai</a> and you are
          never charged.{% endt %}</p>
      </div>
      {%- endif %}

      <ul class="pricing-list">
        <li>{% t %}Unlimited pitch runs: research, scoring and every deliverable{% endt %}</li>
        <li>{% t %}Up to 100 companies in one batch, drafted while the tab is closed{% endt %}</li>
        <li>{% t %}Every colleague on your work-email domain, at no extra cost{% endt %}</li>
        <li>{% t %}Every finished pitch pushed to Close with one press{% endt %}</li>
      </ul>

      {#- The same markup, ids and script as /pricing/'s tile: one field, then
          Stripe. `data-via` is what makes this arrival the Close one — it is on
          the FORM rather than read from the URL, so the offer belongs to the page
          that states it and no query parameter a stranger types can claim it.
          `data-from` sends a cancelled checkout back here instead of to /#pricing. -#}
      <div class="buy" id="buy">
        {%- if offer.close %}
        <a href="{{ '/checkout/' | localize }}" class="btn-cta" id="buyLink">{% t %}Start my free month →{% endt %}</a>
        {%- else %}
        <a href="{{ '/checkout/' | localize }}" class="btn-cta" id="buyLink">{% t %}Start my studio →{% endt %}</a>
        {%- endif %}
        <form class="reserve-form buy-form" id="buyForm" data-via="close" data-from="close" hidden novalidate>
          <input class="reserve-input" id="buyEmail" type="email" autocomplete="email"
                 placeholder="you@yourcompany.com" aria-label="{% t %}Your work email{% endt %}">
          <button class="btn-cta" type="submit" id="buyBtn">
            {%- if offer.close %}{% t %}Start my free month · $0 today →{% endt %}{% else %}{% t %}Pay &amp; start · $999/mo →{% endt %}{% endif -%}
          </button>
        </form>
        <input class="reserve-input buy-site" id="buySite" type="text" inputmode="url" autocomplete="url"
               placeholder="yourcompany.com" aria-label="{% t %}Your company website{% endt %}" hidden>
        <p class="reserve-msg is-error" id="buyMsg" hidden></p>
        <p class="buy-note">
          <span id="buyLive" hidden>{% t %}Next stop is Stripe. This address becomes your studio's sign-in, and a work email brings your whole team in with you.{% endt %} </span>
          {%- if offer.close %}{% t %}Nothing is charged for 30 days. After that, money back any month it doesn't earn its keep.{% endt %}{% else %}{% t %}Money back if it doesn't earn its keep, with no fourteen days of hoping you remember to cancel.{% endt %}{% endif %}
        </p>
      </div>
    </div>
  </section>
{% endset %}

{% include "integration-page.njk" %}
{#- defer, like every script this site serves (#137/#170). buy.js looks its
    elements up by id and returns if they are absent, so this page and
    /pricing/ share it without either knowing about the other. No plan.js:
    there is no switch on this page to drive. -#}
<script src="{{ '/assets/js/buy.js' | asset }}" defer></script>
